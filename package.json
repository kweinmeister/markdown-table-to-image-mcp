{
  "name": "markdown-table-to-image-mcp",
  "version": "1.0.0",
  "description": "FastMCP server that converts markdown tables to beautiful images using Satori and Resvg",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "fastmcp": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "satori": "^0.12.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
