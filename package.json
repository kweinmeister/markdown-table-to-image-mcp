{
  "name": "markdown-table-to-image-mcp",
  "version": "1.0.0",
  "description": "FastMCP server that converts markdown tables to beautiful images using Takumi",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "markdown-table-to-image-mcp": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write ."
  },
  "dependencies": {
    "fastmcp": "^4.24.3",
    "react": "^19.3.1",
    "takumi-js": "^2.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
